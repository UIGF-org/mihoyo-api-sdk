import "@typespec/http";

using TypeSpec.Http;

namespace UIGF.Commerce {
  model ShopGoodsRequest {
    released_flag?: boolean;
    game: string;
    region: string;
    uid: string;
    account: string;
  }

  model BonusDescription extends Record<unknown> {
    bonus_desc?: string;
    bonus_unit?: int32;
    bonus_goods_id?: string;
    bonus_icon?: string;
  }

  model ShopGood extends Record<unknown> {
    goods_id: string;
    goods_name: string;
    goods_type?: string;
    goods_unit?: string;
    goods_icon?: string;
    currency?: string;
    price?: string;
    symbol?: string;
    tier_id?: string;
    bonus_desc?: BonusDescription;
    once_bonus_desc?: BonusDescription | null;
    available?: boolean;
  }

  model ShopGoods extends Record<unknown> {
    goods_list: ShopGood[];
  }

  /**
   * Vendor-signed order creation payload. `sign` must come from an authorized
   * official client or payment integration; this SDK intentionally does not
   * implement signing or retain payment secrets.
   */
  model CreateOrderRequest extends Record<unknown> {
    open_id?: string;
    special_info?: string;
    order: JsonObject;
    sign: string;
  }

  model CheckOrderQuery {
    @query
    order_no: string;

    @query
    game: string;

    @query
    region: string;

    @query
    uid: string;
  }

  model OrderStatus extends Record<unknown> {
    status?: int32;
    amount?: string;
    goods_num?: string;
    goods_title?: string;
    order_no?: string;
    pay_plat?: string;
  }
}

/**
 * Store catalogue and order-state APIs. The `{game}` server parameter is the
 * game SDK host prefix, such as `hk4e` for `hk4e-sdk.mihoyo.com`.
 */
@service(#{ title: "UIGF MiHoYo Commerce API" })
@server(
  "https://{game}-sdk.mihoyo.com",
  "CN game SDK host",
  {
    game: string,
  }
)
namespace UIGF.Commerce.CN {
  @route("/{gameBiz}/mdk")
  interface ShopApi {
    /** Returns purchasable catalogue entries for the authenticated game account. */
    @post
    @route("/shopwindow/shopwindow/fetchGoods")
    fetchGoods(
      @path gameBiz: string,
      @header("Cookie") cookie?: string,
      @body body: UIGF.Commerce.ShopGoodsRequest,
    ): UIGF.ApiResponse<UIGF.Commerce.ShopGoods>;

    /** Sends a vendor-signed order request; no payment signing is generated by this SDK. */
    @post
    @route("/atropos/api/createOrder")
    createOrder(
      @path gameBiz: string,
      @header("Cookie") cookie: string,
      @header("x-rpc-device_id") deviceId: string,
      @body body: UIGF.Commerce.CreateOrderRequest,
    ): UIGF.ApiResponse<UIGF.JsonObject>;

    @get
    @route("/atropos/api/checkOrder")
    checkOrder(
      @path gameBiz: string,
      @header("Cookie") cookie?: string,
      ...UIGF.Commerce.CheckOrderQuery,
    ): UIGF.ApiResponse<UIGF.Commerce.OrderStatus>;
  }
}
